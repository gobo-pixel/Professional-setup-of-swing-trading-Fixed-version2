name: Diagnose Entry vs Exit Fundamentals

on:
  workflow_dispatch:
    inputs:
      symbols:
        description: "Comma-separated symbols to check"
        required: true
        default: "ATHERENERG.NS,EMAMILTD.NS,TITAN.NS,AUROPHARMA.NS,NAM-INDIA.NS"

jobs:
  diagnose:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - name: Run diagnostic
        run: PYTHONPATH=. python scripts/diagnose_entry_vs_exit_fundamentals.py --symbols "${{ inputs.symbols }}"
